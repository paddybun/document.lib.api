@page "/Document/create"

@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject NotificationService NotificationService

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-m-12">
    <RadzenBreadCrumb>
        <ChildContent>
            <RadzenBreadCrumbItem Path="/" Text="Home"/>
            <RadzenBreadCrumbItem Path="/Documents" Text="Documents"/>
            <RadzenBreadCrumbItem Text="Upload"/>
        </ChildContent>
    </RadzenBreadCrumb>

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
            <RadzenText TextStyle="TextStyle.H5" Text="Upload new document"/>
            <RadzenText TextStyle="TextStyle.Body2">
                Choose a PDF. After the upload it lands in the unsorted folder, where you can complete its details and file it.
            </RadzenText>

            <RadzenUpload @ref="_upload" Url="api/upload/single" Accept="application/pdf" Auto="false"
                          ChooseText="Choose PDF" Style="width: 100%"
                          Change="OnChange" Progress="OnProgress" Complete="OnComplete" Error="OnError"/>

            @if (_uploading)
            {
                <RadzenProgressBar Value="_progress" ShowValue="true" Unit="%"/>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem">
                <RadzenButton Text="Upload" Icon="upload" ButtonStyle="ButtonStyle.Primary"
                              Disabled="@(!_hasFile || _uploading)" IsBusy="_uploading" Click="OnUpload"/>
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    @if (_uploadedIds.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" Text="Uploaded successfully"/>
                @foreach (var item in _uploadedIds)
                {
                    <RadzenLink Path="@($"/Documents/{item.Id}")" Text="@($"{item.FileName} - open to complete details")"/>
                }
            </RadzenStack>
        </RadzenAlert>
    }
</RadzenStack>
